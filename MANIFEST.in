include README.md CLAUDE.md LICENSE NOTICE SECURITY.md CONTRIBUTING.md pyproject.toml requirements.txt Makefile Dockerfile docker-compose.yml .env.example .dockerignore .gitignore
recursive-include app/quark_vod *.py *.html *.js *.css *.json
recursive-include app/quark_vod/integrations/jellyfin/scripts *
include app/main.py
recursive-include examples *.json
exclude examples/search.json
recursive-include .github/workflows *.yml *.yaml
recursive-include tests *.py *.js *.sql *.json
include tests/check_sync.py
recursive-include tests/fixtures *.sql
recursive-include docs *.md
exclude Makefile.homelab
exclude tests/test_portal_vod.py tests/test_probe_wrapper.py
exclude docs/agent-architecture.md
prune app/jobs
prune custom-ffmpeg
prune data
prune var
prune logs
global-exclude *.py[cod] *.db *.db-wal *.db-shm *.sqlite *.dump .env
