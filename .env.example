# Public Compose publishes only on loopback by default.
VOD_PUBLISH_ADDRESS=127.0.0.1
VOD_PORT=8099
# Set a long random token locally before using management APIs.
VOD_ADMIN_TOKEN=

# OpenList and the Quark account are configured by each operator.
# In Docker, host.docker.internal points to the Docker host.
OPENLIST_API=http://host.docker.internal:5244
# These URLs must be reachable by the PLAYBACK CLIENT, not only the server.
OPENLIST_PUBLIC=http://localhost:5244
PENDING_BASE_URL=http://localhost:8099
OPENLIST_ADMIN_USER=admin
OPENLIST_ADMIN_PASS=
QUARK_COOKIE=
QUARK_MOUNT=/夸克网盘
QUARK_PLAY_MOUNT=/夸克

# Explicit opt-in integration and maintenance.
VOD_JELLYFIN_ENABLED=false
JELLYFIN2_API_BASE=http://host.docker.internal:8096
JELLYFIN2_KEY=
VOD_MAINTENANCE_ENABLED=false
VOD_STARTUP_SCAN=false
VOD_STARTUP_WRITE_PROBE=false
SELFHEAL_ENABLED=false
AI_PARSE_ENABLED=false
AI_PARSE_BASE_URL=
AI_PARSE_MODEL=
OPENAI_API_KEY=

# Password/token/cookie variables also support corresponding _FILE variables.
# Mount those files read-only in your own Compose override.
# Native Python startup accepts an explicit VOD_ENV_FILE; it never scans HOME.

# Orphan metadata deletion is disabled until both paths are explicitly mapped.
JELLYFIN_METADATA_LIBRARY_DIR=
JELLYFIN_METADATA_LIBRARY_PREFIX=
